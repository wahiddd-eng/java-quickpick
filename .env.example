# Java QuickPick — environment template. PLACEHOLDERS ONLY. Never commit a real .env.
# SANDBOX MODE: real payments are disabled pending FSSAI / GST (CA) / payment-provider / SRM approvals.

NODE_ENV=development
PORT=4000

# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) stored in PGLITE_DATA_DIR.
# For a real PostgreSQL: postgres://user:password@localhost:5432/quickpick
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me
# Secret used by the MOCK payment provider to sign/verify sandbox webhooks.
MOCK_WEBHOOK_SECRET=replace-me

# Comma-separated list of allowed browser origins for the three frontends.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Only "mock" exists. Cashfree / Razorpay adapters are NOT implemented until approved
# credentials and commercial terms exist (see docs/architecture.md).
PAYMENT_PROVIDER=mock

# Development OTP: echo the OTP in the API response (never enable in production).
OTP_DEV_ECHO=true

MIN_LEAD_MINUTES=5
CHECKOUT_TTL_SECONDS=600
